# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Exchange keys. Leave empty to run in dry-run only (paper trades, no orders sent).
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# demo    = keys from Binance Demo Trading (demo.binance.com)
# testnet = keys from the futures testnet (testnet.binancefuture.com)
# Spot testnet keys (testnet.binance.vision) cannot short or use leverage and will not work.
EXCHANGE_MODE=demo

# Any ccxt futures exchange class: binanceusdm, bybit, okx ...
EXCHANGE=binanceusdm

TRIAGE_MODEL=anthropic/claude-haiku-5.5
DECISION_MODEL=anthropic/claude-sonnet-5.5
