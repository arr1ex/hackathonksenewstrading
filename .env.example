# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Exchange keys. Leave empty to run in dry-run only (paper trades, no orders sent).
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# demo    = keys created inside Bybit Demo Trading (bybit.com, switch to Demo Trading, then API)
# testnet = keys from testnet.bybit.com
EXCHANGE_MODE=demo

# ccxt exchange class: bybit (default) or binanceusdm
EXCHANGE=bybit

TRIAGE_MODEL=anthropic/claude-haiku-5.5
DECISION_MODEL=anthropic/claude-sonnet-5.5
